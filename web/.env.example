# Copy to .env.local and fill in. Add the same variables in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database and collection holding the FAQ chunks + embeddings
MONGODB_DB=eduvice
MONGODB_COLLECTION=faq_chunks
# Name of the Atlas Vector Search index on that collection
MONGODB_VECTOR_INDEX=faq_vector_index

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey) — used for embeddings and answers
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# ── Sign-in (Auth.js) ─────────────────────────────────────────────────────────
# Required. Random secret that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Optional: "Continue with Google". Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Web application; authorized redirect URI: http://localhost:3000/api/auth/callback/google, plus your live domain).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional in development (emails are printed to the terminal without it); required in production.
# Sign-in links and account confirmations are sent with Resend: https://resend.com
AUTH_RESEND_KEY=
# Sender address. Must be on a domain you verified in Resend (e.g. eduvice.org).
EMAIL_FROM=EduVice <hello@eduvice.org>
# In production, your site's public URL (used in confirmation links), e.g. https://eduvice.org
AUTH_URL=

# Small model that decides whether a question needs a live AP-credit web search
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
