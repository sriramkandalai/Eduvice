# Copy to .env.local and fill in. Add the same variables in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database and collection holding the FAQ chunks + embeddings
MONGODB_DB=eduvice
MONGODB_COLLECTION=faq_chunks
# Name of the Atlas Vector Search index on that collection
MONGODB_VECTOR_INDEX=faq_vector_index

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey) — used for embeddings and answers
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Small model that decides whether a question needs a live AP-credit web search
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
